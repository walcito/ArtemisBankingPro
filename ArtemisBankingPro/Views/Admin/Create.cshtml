@model ArtemisBankingPro.Core.Application.ViewModels.User.SaveUserViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Crear Usuario";
}

<div class="stage" style="padding:26px 30px;max-width:560px;margin:0 auto;">
    <div class="card panel" style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:26px;box-shadow:var(--shadow);">
        <h2 style="font-family:'Space Grotesk';font-size:20px;margin-bottom:18px;">Crear Usuario</h2>

        @if (Model != null && Model.HasError)
        {
            <div class="alert alert-danger" style="border-radius:10px;font-size:13px;margin-bottom:16px;background:rgba(161,59,59,.1);color:#a13b3b;border:1px solid rgba(161,59,59,.3);padding:12px 16px;">
                @Model.Error
            </div>
        }

        <form asp-controller="Admin" asp-action="Create" method="post">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div>
                    <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Nombre *</label>
                    <input asp-for="FirstName" placeholder="Nombre" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
                    <span asp-validation-for="FirstName" class="text-danger" style="font-size:11px;"></span>
                </div>
                <div>
                    <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Apellido *</label>
                    <input asp-for="LastName" placeholder="Apellido" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
                    <span asp-validation-for="LastName" class="text-danger" style="font-size:11px;"></span>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div>
                    <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Cédula *</label>
                    <input asp-for="Identification" placeholder="402-0000000-0" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
                    <span asp-validation-for="Identification" class="text-danger" style="font-size:11px;"></span>
                </div>
                <div>
                    <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Correo *</label>
                    <input asp-for="Email" placeholder="correo@ejemplo.com" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:11px;"></span>
                </div>
            </div>

            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Nombre de usuario *</label>
                <input asp-for="UserName" placeholder="usuario" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
                <span asp-validation-for="UserName" class="text-danger" style="font-size:11px;"></span>
            </div>

            <div style="margin-bottom:14px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Rol *</label>
                <select id="roleSelect" asp-for="Role" onchange="toggleInitialAmount()" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);">
                    <option value="Client">Cliente</option>
                    <option value="Cashier">Cajero</option>
                    <option value="Admin">Administrador</option>
                </select>
                <span asp-validation-for="Role" class="text-danger" style="font-size:11px;"></span>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
                <div>
                    <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Contraseña *</label>
                    <input asp-for="Password" type="password" placeholder="••••••••" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:11px;"></span>
                    <small style="display:block;font-size:11px;color:var(--text-faint);margin-top:4px;">Min 6 caracteres (incluir mayúscula, número y carácter especial)</small>
                </div>
                <div>
                    <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Confirmar Contraseña *</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="••••••••" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:11px;"></span>
                </div>
            </div>

            <div id="initialAmountContainer" style="margin-bottom:18px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Monto inicial (Solo Cliente)</label>
                <input id="InitialAmount" asp-for="InitialAmount" placeholder="5000.00" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
            </div>

            <div style="display:flex;gap:10px;">
                <a asp-controller="Admin" asp-action="Index" class="btn btn-ghost" style="padding:10px 18px;border:1px solid var(--border);border-radius:8px;">Volver atrás</a>
                <button type="submit" class="btn btn-primary" style="background:#35648B;color:#fff;padding:10px 18px;border-radius:8px;border:none;font-weight:700;">Crear usuario</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleInitialAmount() {
            var roleSelect = document.getElementById('roleSelect');
            var container = document.getElementById('initialAmountContainer');
            if (roleSelect && container) {
                if (roleSelect.value === 'Client' || roleSelect.value === 'Cliente') {
                    container.style.display = 'block';
                } else {
                    container.style.display = 'none';
                    var input = document.getElementById('InitialAmount');
                    if (input) input.value = '0.00';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            toggleInitialAmount();
        });
    </script>
}
