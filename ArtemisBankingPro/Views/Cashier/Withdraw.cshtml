@model ArtemisBankingPro.Core.Application.Features.SavingsAccounts.Commands.Withdraw.WithdrawCommand

@{ ViewData["Title"] = "Retiro"; }

<h2>Retiro de Cuenta de Ahorro</h2>

<form asp-action="Withdraw" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="AccountNumber" class="form-label">Número de Cuenta</label>
        <input asp-for="AccountNumber" class="form-control" />
        <span asp-validation-for="AccountNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Monto</label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success" onclick="return confirm('¿Confirmar retiro?');">Confirmar Retiro</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>