@model ArtemisBankingPro.Core.Application.Features.SavingsAccounts.Commands.Withdraw.WithdrawCommand

@{ ViewData["Title"] = "Retiro de efectivo"; }

<div class="two-col">
    <div class="card panel">
        <form asp-action="Withdraw" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-info" style="@(!ViewData.ModelState.IsValid ? "" : "display:none;")"></div>

            <div class="field">
                <label asp-for="AccountNumber">Número de cuenta de ahorro <span class="req">*</span></label>
                <input asp-for="AccountNumber" placeholder="Ej. 410207765" />
                <span asp-validation-for="AccountNumber" class="text-danger" style="font-size:11px;"></span>
            </div>

            <div class="field">
                <label asp-for="Amount">Monto a retirar <span class="req">*</span></label>
                <input asp-for="Amount" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="Amount" class="text-danger" style="font-size:11px;"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Continuar</button>
        </form>
    </div>

    <div class="card panel">
        <div class="section-title">Reglas clave</div>
        <ul style="margin:0;padding-left:18px;font-size:12.3px;color:var(--text-dim);line-height:1.7;">
            <li>La cuenta debe existir y estar activa.</li>
            <li>Debe haber fondos suficientes en la cuenta.</li>
            <li>El retiro se registra como transacción de tipo Débito.</li>
            <li>Se notifica por correo al cliente.</li>
        </ul>
    </div>
</div>