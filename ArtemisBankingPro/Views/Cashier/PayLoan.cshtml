@model ArtemisBankingPro.Core.Application.Features.Cashier.Commands.PayLoan.PayLoanCommand

@{ ViewData["Title"] = "Pago de Préstamo"; }

<h2>Pago de Préstamo</h2>

<form asp-action="PayLoan" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="SourceAccountNumber" class="form-label">Cuenta de Origen</label>
        <input asp-for="SourceAccountNumber" class="form-control" />
        <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LoanId" class="form-label">ID del Préstamo</label>
        <input asp-for="LoanId" class="form-control" />
        <span asp-validation-for="LoanId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Monto a Pagar</label>
        <input asp-for="Amount" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success" onclick="return confirm('¿Confirmar pago de préstamo?');">Confirmar Pago</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>