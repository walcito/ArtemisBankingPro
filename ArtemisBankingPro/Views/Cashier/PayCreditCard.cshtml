@model ArtemisBankingPro.Core.Application.Features.Cashier.Commands.PayCreditCard.PayCreditCardCommand

@{ ViewData["Title"] = "Pago a Tarjeta de Crédito"; }

<div class="topbar">
    <div class="crumb">Cajero</div>
    <h1 id="screen-title">Pago a tarjeta de crédito</h1>
</div>

<div class="two-col">
    <div class="card panel">
        <form asp-action="PayCreditCard" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-info"></div>

            <div class="field">
                <label asp-for="SourceAccountNumber">Cuenta de Origen <span class="req">*</span></label>
                <input asp-for="SourceAccountNumber" />
                <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="CreditCardId">ID de la Tarjeta <span class="req">*</span></label>
                <input asp-for="CreditCardId" type="number" />
                <span asp-validation-for="CreditCardId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Amount">Monto a Pagar <span class="req">*</span></label>
                <input asp-for="Amount" type="number" step="0.01" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Continuar</button>
        </form>
    </div>

    <div class="card panel">
        <div class="section-title">Reglas clave</div>
        <ul style="margin:0;padding-left:18px;font-size:12.3px;color:var(--text-dim);line-height:1.7;">
            <li>El monto no puede superar la deuda actual de la tarjeta.</li>
            <li>La tarjeta debe estar activa.</li>
        </ul>
    </div>
</div>