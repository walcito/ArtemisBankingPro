@model ArtemisBankingPro.Core.Application.ViewModels.Card.CancelCreditCardViewModel

@{
    ViewData["Title"] = "Cancelar Tarjeta";
}

<div class="mb-3">
    <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: .12em;">Administrador</span>
    <h2 style="font-family: 'Space Grotesk', sans-serif; font-weight: 700;">Cancelar Tarjeta de Crédito</h2>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card panel p-4 shadow-sm border" style="border-radius: 16px;">
            <div class="p-3 mb-3" style="border: 1.5px dashed #dde3ec; border-radius: 14px;">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Tarjeta</span>
                    <b>•••• @Model.LastFourDigits</b>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Titular</span>
                    <b>@Model.ClientFullName</b>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted">Deuda pendiente</span>
                    <b class="@(Model.CurrentDebt > 0 ? "text-danger" : "text-success")">RD$@Model.CurrentDebt.ToString("N2")</b>
                </div>
            </div>

            <p style="font-size: 13.5px;" class="mb-3">¿Está seguro que desea cancelar la tarjeta [•••• @Model.LastFourDigits]?</p>

            @if (Model.CurrentDebt > 0)
            {
                <div class="alert alert-danger" role="alert" style="font-size: 12.5px;">
                    Para cancelar esta tarjeta, el cliente debe saldar la totalidad de la deuda pendiente.
                </div>
            }

            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill" style="border-radius: 10px; padding: 10px 18px;">Cancelar</a>
                    <button type="submit" class="btn btn-danger flex-fill" style="border-radius: 10px; padding: 10px 18px;" @(Model.CurrentDebt > 0 ? "disabled" : "")>
                        Aceptar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
