@model ArtemisBankingPro.Core.Application.ViewModels.Card.UpdateCreditLimitViewModel

@{
    ViewData["Title"] = "Editar Límite de Tarjeta";
}

<div class="mb-3">
    <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: .12em;">Administrador</span>
    <h2 style="font-family: 'Space Grotesk', sans-serif; font-weight: 700;">Modificar Límite de Crédito</h2>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card panel p-4 shadow-sm border" style="border-radius: 16px;">
            <form asp-action="EditLimit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 12.3px;">Tarjeta</label>
                    <input type="text" value="@Model.MaskedCardNumber" class="form-control bg-light" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 12.3px;">Cliente</label>
                    <input type="text" value="@Model.ClientFullName" class="form-control bg-light" readonly />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-bold" style="font-size: 12.3px;">Límite actual</label>
                        <input type="text" value="RD$@Model.CurrentCreditLimit.ToString("N2")" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold" style="font-size: 12.3px;">Deuda actual</label>
                        <input type="text" value="RD$@Model.CurrentDebt.ToString("N2")" class="form-control bg-light text-danger fw-bold" readonly />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewCreditLimit" class="form-label fw-bold" style="font-size: 12.3px;">Nuevo límite de crédito <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">RD$</span>
                        <input asp-for="NewCreditLimit" class="form-control" type="number" step="0.01" style="padding: 11px 13px;" />
                    </div>
                    <span asp-validation-for="NewCreditLimit" class="text-danger" style="font-size: 11.5px;"></span>
                    <div class="text-muted mt-1" style="font-size: 11.3px;">El nuevo límite no puede ser inferior a la deuda actual (RD$@Model.CurrentDebt.ToString("N2")).</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 10px; padding: 10px 18px;">Volver atrás</a>
                    <button type="submit" class="btn btn-primary" style="background-color: var(--c5, #35648B); border-color: var(--c5, #35648B); border-radius: 10px; padding: 10px 18px;">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
