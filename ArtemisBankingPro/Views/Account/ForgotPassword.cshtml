@model ArtemisBankingPro.Core.Application.ViewModels.Account.ForgotPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="card panel" style="max-width:420px;margin:40px auto;padding:26px;background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);">
    <div class="section-title" style="font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint);margin-bottom:14px;">Solicitar restablecimiento</div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success" style="background:rgba(181,209,217,.35);border:1px solid rgba(181,209,217,.6);color:#274b69;padding:12px;border-radius:10px;margin-bottom:14px;font-size:12.5px;">
            @ViewBag.Message
        </div>
    }

    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div class="field" style="margin-bottom:14px;">
            <label style="display:block;font-size:12.3px;font-weight:700;margin-bottom:6px;">Nombre de usuario <span style="color:#a13b3b;">*</span></label>
            <input asp-for="UserName" placeholder="m.fernandez" style="width:100%;padding:11px 13px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);" />
            <span asp-validation-for="UserName" class="text-danger" style="font-size:11px;"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="width:100%;background:#35648B;color:#fff;padding:11px;border-radius:10px;font-weight:700;border:none;cursor:pointer;margin-bottom:10px;">Enviar solicitud</button>
        <a asp-controller="Account" asp-action="Login" class="btn btn-ghost btn-block" style="display:block;text-align:center;padding:10px;border:1px solid var(--border);border-radius:10px;font-size:13px;font-weight:700;">Volver al login</a>
    </form>
</div>
