@model ArtemisBankingPro.Core.Application.ViewModels.Account.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Restablecer Contraseña - Artemis Banking Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-theme="light" style="background:var(--bg);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;">
    <div class="card panel" style="max-width:440px;width:100%;padding:34px;background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);">
        <h2 style="font-family:'Space Grotesk';font-size:20px;margin-bottom:8px;">Restablecer contraseña</h2>
        <p style="font-size:13px;color:var(--text-dim);margin-bottom:20px;">Ingrese su nombre de usuario para enviarle un enlace de restablecimiento.</p>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success" style="background:rgba(181,209,217,.4);border:1px solid rgba(53,100,139,.3);color:#274b69;padding:12px;border-radius:10px;margin-bottom:14px;font-size:13px;">
                @ViewBag.Message
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div style="margin-bottom:18px;">
                <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;">Nombre de usuario *</label>
                <input asp-for="UserName" placeholder="m.fernandez" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);" />
                <span asp-validation-for="UserName" class="text-danger" style="font-size:11px;"></span>
            </div>

            <div style="display:flex;gap:10px;">
                <a asp-controller="Account" asp-action="Login" class="btn btn-ghost" style="padding:10px 18px;border:1px solid var(--border);border-radius:8px;text-decoration:none;">Volver al login</a>
                <button type="submit" class="btn btn-primary" style="background:#35648B;color:#fff;padding:10px 18px;border-radius:8px;border:none;font-weight:700;cursor:pointer;">Enviar enlace</button>
            </div>
        </form>
    </div>
</body>
</html>
