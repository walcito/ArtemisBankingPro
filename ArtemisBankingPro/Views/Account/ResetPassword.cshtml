@model ArtemisBankingPro.Core.Application.ViewModels.Account.ResetPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Crear Nueva Contraseña";
}

<div class="card panel" style="max-width:420px;margin:40px auto;padding:26px;background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:var(--shadow);">
    <div class="section-title" style="font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint);margin-bottom:14px;">Restablecer Contraseña</div>

    @if (Model != null && Model.HasError)
    {
        <div class="alert alert-warn" style="background:rgba(161,59,59,.1);border:1px solid rgba(161,59,59,.3);color:#a13b3b;padding:12px;border-radius:10px;margin-bottom:14px;font-size:13px;">
            @Model.Error
        </div>
    }

    <form asp-controller="Account" asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <div class="field" style="margin-bottom:14px;">
            <label style="display:block;font-size:12.3px;font-weight:700;margin-bottom:6px;">Nueva contraseña <span style="color:#a13b3b;">*</span></label>
            <input asp-for="Password" type="password" placeholder="••••••••" style="width:100%;padding:11px 13px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);" />
            <span asp-validation-for="Password" class="text-danger" style="font-size:11px;"></span>
        </div>

        <div class="field" style="margin-bottom:18px;">
            <label style="display:block;font-size:12.3px;font-weight:700;margin-bottom:6px;">Confirmar contraseña <span style="color:#a13b3b;">*</span></label>
            <input asp-for="ConfirmPassword" type="password" placeholder="••••••••" style="width:100%;padding:11px 13px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);" />
            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:11px;"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="width:100%;background:#35648B;color:#fff;padding:11px;border-radius:10px;font-weight:700;border:none;cursor:pointer;">Restablecer contraseña</button>
    </form>
</div>
