@model ArtemisBankingPro.Core.Application.ViewModels.Account.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Iniciar Sesión";
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:0;max-width:920px;margin:40px auto;border-radius:18px;overflow:hidden;box-shadow:var(--shadow);">
    <div style="padding:44px 38px;background:linear-gradient(160deg,#35648B,#6D8A99 75%,#8FA3CA);color:#fff;display:flex;flex-direction:column;justify-content:space-between;min-height:460px;">
        <div>
            <div style="font-family:'Space Grotesk';font-weight:700;font-size:22px;">Artemis Banking Pro</div>
            <div style="font-size:12px;opacity:.8;margin-top:4px;">Banca digital integral</div>
        </div>
        <div class="bankcard" style="background:rgba(255,255,255,.12);box-shadow:none;backdrop-filter:blur(6px);padding:22px;border-radius:18px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;">
                <div style="width:34px;height:25px;border-radius:5px;background:linear-gradient(135deg,#e7d99a,#c9ab5f);"></div>
                <span class="pulse-dot"></span>
            </div>
            <div style="font-family:'Space Grotesk';font-size:18px;letter-spacing:.12em;margin-bottom:15px;">•••• •••• •••• 4821</div>
            <div style="display:flex;justify-content:space-between;">
                <div><div style="font-size:9.5px;text-transform:uppercase;opacity:.75;">Titular</div><div style="font-size:14px;font-weight:600;">M. FERNÁNDEZ</div></div>
                <div><div style="font-size:9.5px;text-transform:uppercase;opacity:.75;">Vence</div><div style="font-size:14px;font-weight:600;">09/28</div></div>
            </div>
        </div>
        <div style="font-size:11.5px;opacity:.75;">Gestiona cuentas, préstamos, tarjetas y pagos desde un solo lugar.</div>
    </div>

    <div class="card" style="border:none;border-radius:0;padding:44px 38px;background:var(--surface);">
        <div class="section-title" style="font-size:11.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint);margin-bottom:18px;">Acceder a mi cuenta</div>

        @if (Model != null && Model.HasError)
        {
            <div class="alert alert-warn" style="background:rgba(161,59,59,.1);border:1px solid rgba(161,59,59,.3);color:#a13b3b;padding:12px;border-radius:10px;margin-bottom:14px;font-size:13px;">
                @Model.Error
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="field" style="margin-bottom:14px;">
                <label style="display:block;font-size:12.3px;font-weight:700;margin-bottom:6px;">Nombre de usuario <span style="color:#a13b3b;">*</span></label>
                <input asp-for="UserName" placeholder="m.fernandez" style="width:100%;padding:11px 13px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);" />
                <span asp-validation-for="UserName" class="text-danger" style="font-size:11px;"></span>
            </div>

            <div class="field" style="margin-bottom:18px;">
                <label style="display:block;font-size:12.3px;font-weight:700;margin-bottom:6px;">Contraseña <span style="color:#a13b3b;">*</span></label>
                <input asp-for="Password" type="password" placeholder="••••••••" style="width:100%;padding:11px 13px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:11px;"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="width:100%;background:#35648B;color:#fff;padding:11px;border-radius:10px;font-weight:700;border:none;cursor:pointer;">Iniciar sesión</button>
        </form>

        <div style="text-align:center;font-size:12.3px;margin-top:14px;">
            <a asp-controller="Account" asp-action="ForgotPassword" style="color:#35648B;font-weight:700;">Restablecer contraseña</a>
        </div>
    </div>
</div>
