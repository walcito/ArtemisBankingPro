@model ArtemisBankingPro.Core.Application.Common.Models.PagedResult<ArtemisBankingPro.Core.Application.Features.Loans.Queries.GetLoans.LoanDto>

@{
    ViewData["Title"] = "Gestión de Préstamos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Gestión de Préstamos</h2>
</div>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label fw-bold">Filtrar por estado</label>
        <select name="status" class="form-select">
            <option value="">Todos</option>
            <option value="Active" selected="@(Context.Request.Query["status"] == "Active")">Activos</option>
            <option value="Paid" selected="@(Context.Request.Query["status"] == "Paid")">Pagados</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-bold">Buscar por cédula</label>
        <input type="text" name="identificationNumber" class="form-control" placeholder="402-0000000-0" value="@Context.Request.Query["identificationNumber"]" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
    <div class="col text-end">
        <button type="button" class="btn btn-primary">+ Asignar préstamo</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>N° préstamo</th>
                    <th>Cliente</th>
                    <th>Capital</th>
                    <th>Pendiente</th>
                    <th>Tasa</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
    <tbody>
        @if (Model != null && Model.Items != null && Model.Items.Any())
        {
            @foreach (var loan in Model.Items)
            {
                <tr>
                    <td class="fw-bold">@loan.LoanNumber</td>
                    <td>@loan.UserFullName</td>
                    <td>@loan.DisbursedAmount.ToString("C2")</td>
                    <td>@loan.CurrentDebt.ToString("C2")</td>
                    <td>@loan.AnnualInterestRate.ToString("0.00")%</td>
                    <td>
                        <span class="badge @(loan.Status.ToString() == "Active" ? "bg-success" : (loan.Status.ToString() == "Paid" ? "bg-secondary" : "bg-dark"))">
                            @loan.Status
                        </span>
                    </td>
                    <td class="d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@loan.Id" class="btn btn-sm btn-outline-secondary">
                            Ver detalles
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-secondary">Editar tasa</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center py-4">No se encontraron préstamos.</td>
            </tr>
        }
    </tbody>
        </table>
    </div>
</div>

@if (Model != null && Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" 
                       asp-route-identificationNumber="@Context.Request.Query["identificationNumber"]" 
                       asp-route-status="@Context.Request.Query["status"]">@i</a>
                </li>
            }
        </ul>
    </nav>
}
