@model ArtemisBankingPro.Core.Application.ViewModels.Loan.LoanListViewModel

@{
    ViewData["Title"] = "Gestión de Préstamos";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h1 style="font-family:'Space Grotesk'; font-size:22px; margin:0; font-weight:700;">Gestión de Préstamos</h1>
    <a asp-action="SelectClient" class="btn btn-primary" style="background:#35648B; color:#fff; padding:10px 18px; border-radius:10px; font-weight:700; display:inline-block; text-decoration:none;">+ Asignar préstamo</a>
</div>

<form method="get" class="toolbar" style="display:flex; gap:12px; align-items:flex-end; margin-bottom:20px; flex-wrap:wrap;">
    <div class="field" style="max-width:180px;">
        <label style="display:block; font-size:12px; font-weight:700; margin-bottom:6px;">Filtrar por estado</label>
        <select name="status" onchange="this.form.submit()" style="width:100%; padding:9px 12px; border-radius:8px; border:1px solid var(--border);">
            <option value="">Todos</option>
            <option value="Active" selected="@(Context.Request.Query["status"] == "Active")">Activos</option>
            <option value="Paid" selected="@(Context.Request.Query["status"] == "Paid")">Pagados</option>
        </select>
    </div>
    <div class="field" style="max-width:240px;">
        <label style="display:block; font-size:12px; font-weight:700; margin-bottom:6px;">Buscar por cédula</label>
        <input type="text" name="identificationNumber" placeholder="402-0000000-0" value="@Context.Request.Query["identificationNumber"]" style="width:100%; padding:9px 12px; border-radius:8px; border:1px solid var(--border);" />
    </div>
    <div>
        <button type="submit" class="btn btn-primary" style="background:#35648B; color:#fff; padding:9px 16px; border-radius:8px; border:none; font-weight:700; cursor:pointer;">Buscar</button>
    </div>
</form>

<div class="card-abp" style="overflow:hidden;">
    <table class="table-abp">
        <thead>
            <tr>
                <th>N° préstamo</th>
                <th>Cliente</th>
                <th>Capital</th>
                <th>Pendiente</th>
                <th>Tasa</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Items != null && Model.Items.Any())
            {
                @foreach (var loan in Model.Items)
                {
                    <tr>
                        <td style="font-weight:700;">@loan.LoanNumber</td>
                        <td>@loan.UserFullName</td>
                        <td style="font-weight:600;">@loan.DisbursedAmount.ToString("C2")</td>
                        <td style="font-weight:700; color:var(--danger);">@loan.CurrentDebt.ToString("C2")</td>
                        <td>@loan.AnnualInterestRate.ToString("0.00")%</td>
                        <td>
                            @{
                                var isAct = loan.Status.ToString() == "Active";
                                var badgeCls = isAct ? "badge-abp ok" : "badge-abp warn";
                            }
                            <span class="@badgeCls">
                                @(isAct ? "Activo" : loan.Status.ToString())
                            </span>
                        </td>
                        <td style="display:flex; gap:8px;">
                            <a asp-action="Details" asp-route-id="@loan.Id" class="btn-abp btn-abp-ghost btn-abp-sm">
                                Ver detalles
                            </a>
                            @if (isAct)
                            {
                                <a asp-action="EditRate" asp-route-id="@loan.Id" class="btn-abp btn-abp-ghost btn-abp-sm">
                                    Editar
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align:center; padding:36px; color:var(--text-faint);">
                        No se encontraron préstamos registrados.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model != null && Model.TotalPages > 1)
{
    <div style="margin-top:20px; display:flex; gap:8px;">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-pageNumber="@i" 
               asp-route-identificationNumber="@Context.Request.Query["identificationNumber"]" 
               asp-route-status="@Context.Request.Query["status"]"
               class="btn-abp @(i == Model.PageNumber ? "btn-abp-primary" : "btn-abp-ghost") btn-abp-sm">@i</a>
        }
    </div>
}
