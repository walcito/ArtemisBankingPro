@model ArtemisBankingPro.Core.Application.Features.Loans.Queries.ObtenerDetallePrestamo.DetallePrestamoDto

@{
    ViewData["Title"] = "Detalle del Préstamo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Préstamo @Model.LoanNumber — Amortización</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al Listado</a>
</div>

<div class="mb-4">
    <h5 class="mb-1">@Model.UserFullName</h5>
    <h6 class="text-muted">Cédula: @Model.UserIdentificationNumber</h6>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm h-100 p-3">
            <h3 class="fw-bold mb-1">@Model.DisbursedAmount.ToString("C2")</h3>
            <span class="text-muted small fw-bold">CAPITAL APROBADO</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 p-3">
            <h3 class="fw-bold text-danger mb-1">@Model.CurrentDebt.ToString("C2")</h3>
            <span class="text-muted small fw-bold">PENDIENTE</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 p-3">
            <h3 class="fw-bold mb-1">@Model.AnnualInterestRate.ToString("0.00")%</h3>
            <span class="text-muted small fw-bold">TASA ANUAL</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100 p-3">
            <h3 class="fw-bold mb-1">
                <span class="badge @(Model.Status.ToString() == "Active" ? "bg-success" : (Model.Status.ToString() == "Paid" ? "bg-secondary" : "bg-dark"))">
                    @Model.Status
                </span>
            </h3>
            <span class="text-muted small fw-bold">ESTADO</span>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center">#</th>
                    <th class="text-end">Valor cuota</th>
                    <th class="text-end">Interés</th>
                    <th class="text-end">Capital</th>
                    <th class="text-end">Balance Pendiente</th>
                    <th class="text-center">Estado</th>
                </tr>
            </thead>
        <tbody>
            @if (Model.Installments != null && Model.Installments.Any())
            {
                @foreach (var inst in Model.Installments.OrderBy(i => i.InstallmentNumber))
                {
                    <tr>
                        <td class="text-center fw-bold">@inst.InstallmentNumber</td>
                        <td class="text-end">@inst.InstallmentAmount.ToString("C2")</td>
                        <td class="text-end text-muted">@inst.Interest.ToString("C2")</td>
                        <td class="text-end text-muted">@inst.PrincipalAmortization.ToString("C2")</td>
                        <td class="text-end fw-bold">@inst.PendingBalance.ToString("C2")</td>
                        <td class="text-center">
                            @{
                                string badgeClass = "bg-secondary";
                                if (inst.Status.ToString() == "Pending") badgeClass = "bg-warning text-dark";
                                else if (inst.Status.ToString() == "Paid") badgeClass = "bg-success";
                                else if (inst.Status.ToString() == "PartiallyPaid") badgeClass = "bg-info text-dark";
                                else if (inst.Status.ToString() == "Late") badgeClass = "bg-danger";
                            }
                            <span class="badge @badgeClass">
                                @inst.Status
                            </span>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4">No hay cuotas generadas para este préstamo.</td>
                </tr>
            }
        </tbody>
        </table>
    </div>
</div>
