@model ArtemisBankingPro.Core.Application.ViewModels.Loan.SelectClientForLoanViewModel

@{
    ViewData["Title"] = "Asignar Préstamo - Seleccionar Cliente";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="margin:0; font-size:24px; font-weight:700;">Seleccionar Cliente</h2>
    <a asp-action="Index" class="btn-abp btn-abp-ghost">← Volver al listado</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="border-radius:var(--radius); margin-bottom:20px;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="stat-grid-abp" style="margin-bottom:20px;">
    <div class="card-abp stat-abp">
        <div class="num">@Model.AverageDebt.ToString("C2")</div>
        <div class="lbl">Monto promedio de deuda en el sistema</div>
    </div>
</div>

<form method="get" asp-action="SelectClient" class="row g-3 mb-4 align-items-end">
    <div class="col-md-6 field-abp" style="margin-bottom:0;">
        <label>Buscar por cédula</label>
        <input type="text" name="identificationNumber" placeholder="402-0000000-0" value="@Model.SearchIdentification" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn-abp btn-abp-ghost">Buscar</button>
    </div>
</form>

<form method="get" asp-action="AssignForm">
    <div class="card-abp" style="overflow:hidden;">
        <table class="table-abp">
            <thead>
                <tr>
                    <th style="width:50px; text-align:center;">Sel.</th>
                    <th>Cédula</th>
                    <th>Nombre y apellido</th>
                    <th>Correo electrónico</th>
                    <th style="text-align:right;">Monto total de deuda</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clients != null && Model.Clients.Any())
                {
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td style="text-align:center;">
                                <input type="radio" name="userId" value="@client.Id" required style="width:18px; height:18px; cursor:pointer;" />
                            </td>
                            <td style="font-weight:700;">@client.IdentificationNumber</td>
                            <td>@client.FullName</td>
                            <td style="color:var(--text-dim);">@client.Email</td>
                            <td style="text-align:right; font-weight:700; color:@(client.TotalDebt > 0 ? "var(--danger)" : "var(--text)")">
                                @client.TotalDebt.ToString("C2")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding:36px; color:var(--text-faint);">
                            @if (!string.IsNullOrEmpty(Model.SearchIdentification))
                            {
                                <span>No existe un cliente registrado con esta cédula o este cliente ya tiene un préstamo registrado.</span>
                            }
                            else
                            {
                                <span>No se encontraron clientes elegibles en el sistema.</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Clients != null && Model.Clients.Any())
    {
        <div style="margin-top:20px; display:flex; justify-content:flex-end;">
            <button type="submit" class="btn btn-primary" style="background:#35648B; color:#fff; padding:10px 20px; border-radius:10px; font-weight:700; border:none; cursor:pointer;">Siguiente paso →</button>
        </div>
    }
</form>
