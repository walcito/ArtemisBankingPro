<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Artemis Banking Pro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-theme="light">
    <div class="shell">
        <!-- ============ SIDEBAR ============ -->
        <aside class="sidebar">
            <div class="brand">
                <svg class="brand-mark" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="19" fill="none" stroke="var(--border)" stroke-width="1"/>
                    <path d="M20 5 L35 13 V16 H5 V13 Z" fill="var(--c5)"/>
                    <rect x="8" y="17" width="4" height="13" fill="var(--c4)"/>
                    <rect x="18" y="17" width="4" height="13" fill="var(--c3)"/>
                    <rect x="28" y="17" width="4" height="13" fill="var(--c4)"/>
                    <rect x="5" y="31" width="30" height="3" fill="var(--c5)"/>
                </svg>
                <div class="brand-name">Artemis Banking<span>Digital Banking</span></div>
            </div>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="nav-group">
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="nav-title">Administrador</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                            <span class="dot"></span>Gestión de Usuarios
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Loans" ? "active" : "")" asp-controller="Loans" asp-action="Index">
                            <span class="dot"></span>Gestión de Préstamos
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SavingsAccount" ? "active" : "")" asp-controller="SavingsAccount" asp-action="Index">
                            <span class="dot"></span>Cuentas de Ahorro
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "CreditCard" ? "active" : "")" asp-controller="CreditCard" asp-action="Index">
                            <span class="dot"></span>Tarjetas de Crédito
                        </a>
                        <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Commerce" ? "active" : "")" asp-controller="Commerce" asp-action="Index">
                            <span class="dot"></span>Comercios
                        </a>
                    }
                    else if (User.IsInRole("Teller") || User.IsInRole("Cashier") || User.IsInRole("Cajero"))
                    {
                        var cashierAction = ViewContext.RouteData.Values["action"]?.ToString();
                        <div class="nav-title">Cajero</div>
                        <a class="nav-item @(cashierAction == "Index" ? "active" : "")" asp-controller="Cashier" asp-action="Index">
                            <span class="dot"></span>Dashboard
                        </a>
                        <a class="nav-item @(cashierAction == "Deposit" || cashierAction == "ConfirmDeposit" || cashierAction == "DepositSuccess" ? "active" : "")" asp-controller="Cashier" asp-action="Deposit">
                            <span class="dot"></span>Depósito
                        </a>
                        <a class="nav-item @(cashierAction == "Withdraw" || cashierAction == "ConfirmWithdraw" || cashierAction == "WithdrawSuccess" ? "active" : "")" asp-controller="Cashier" asp-action="Withdraw">
                            <span class="dot"></span>Retiro
                        </a>
                        <a class="nav-item @(cashierAction == "ThirdPartyTransaction" || cashierAction == "ConfirmThirdPartyTransaction" || cashierAction == "ThirdPartyTransactionSuccess" ? "active" : "")" asp-controller="Cashier" asp-action="ThirdPartyTransaction">
                            <span class="dot"></span>Transacción a Terceros
                        </a>
                        <a class="nav-item @(cashierAction == "PayCreditCard" || cashierAction == "ConfirmPayCreditCard" || cashierAction == "PayCreditCardSuccess" ? "active" : "")" asp-controller="Cashier" asp-action="PayCreditCard">
                            <span class="dot"></span>Pago a Tarjeta
                        </a>
                        <a class="nav-item @(cashierAction == "PayLoan" || cashierAction == "ConfirmPayLoan" || cashierAction == "PayLoanSuccess" ? "active" : "")" asp-controller="Cashier" asp-action="PayLoan">
                            <span class="dot"></span>Pago a Préstamo
                        </a>
                    }
                    else if (User.IsInRole("Client") || User.IsInRole("Cliente"))
                    {
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                        <div class="nav-title">Cliente</div>
                        <a class="nav-item @(currentAction == "Index" ? "active" : "")" asp-controller="Client" asp-action="Index">
                            <span class="dot"></span>Mis Productos
                        </a>
                        <a class="nav-item @(currentAction == "ExpressTransaction" ? "active" : "")" asp-controller="Client" asp-action="ExpressTransaction">
                            <span class="dot"></span>Pago Expreso
                        </a>
                        <a class="nav-item @(currentAction == "PayCreditCard" ? "active" : "")" asp-controller="Client" asp-action="PayCreditCard">
                            <span class="dot"></span>Pago de Tarjeta
                        </a>
                        <a class="nav-item @(currentAction == "PayLoan" ? "active" : "")" asp-controller="Client" asp-action="PayLoan">
                            <span class="dot"></span>Pago de Préstamo
                        </a>
                        <a class="nav-item @(currentAction == "TransferOwnAccounts" ? "active" : "")" asp-controller="Client" asp-action="TransferOwnAccounts">
                            <span class="dot"></span>Transferir Cuentas Propias
                        </a>
                        <a class="nav-item @(currentAction == "TransferToBeneficiary" ? "active" : "")" asp-controller="Client" asp-action="TransferToBeneficiary">
                            <span class="dot"></span>Transferir a Beneficiario
                        </a>
                        <a class="nav-item @(currentAction == "CashAdvance" ? "active" : "")" asp-controller="Client" asp-action="CashAdvance">
                            <span class="dot"></span>Avance de Efectivo
                        </a>
                        <a class="nav-item @(currentAction == "Beneficiaries" ? "active" : "")" asp-controller="Client" asp-action="Beneficiaries">
                            <span class="dot"></span>Mis Beneficiarios
                        </a>
                    }
                    
                    <div style="margin-top:20px;padding:0 8px;">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-danger btn-sm w-100" style="font-weight:700;">Cerrar Sesión</button>
                        </form>
                    </div>
                </div>
            }
        </aside>

        <!-- ============ MAIN ============ -->
        <div class="main">
            <div class="topbar">
                <div class="topbar-left">
                    <div class="crumb">Artemis Banking Pro</div>
                    <h1>@(ViewData["Title"] ?? "Dashboard")</h1>
                </div>
                <div class="theme-toggle">
                    <div class="toggle-knob" id="toggleKnob"></div>
                    <button id="btnLight" class="on" onclick="setTheme('light')">☀ Claro</button>
                    <button id="btnDark" onclick="setTheme('dark')">☾ Oscuro</button>
                </div>
            </div>

            <div class="stage">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function setTheme(t) {
            document.body.setAttribute('data-theme', t);
            const btnLight = document.getElementById('btnLight');
            const btnDark = document.getElementById('btnDark');
            if (btnLight && btnDark) {
                btnLight.classList.toggle('on', t === 'light');
                btnDark.classList.toggle('on', t === 'dark');
            }
            localStorage.setItem('abp-theme', t);
        }
        (function() {
            const saved = localStorage.getItem('abp-theme') || 'light';
            setTheme(saved);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
