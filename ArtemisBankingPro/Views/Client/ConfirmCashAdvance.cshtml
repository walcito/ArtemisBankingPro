@model ArtemisBankingPro.Core.Application.ViewModels.Client.CashAdvanceViewModel
@{ ViewData["Title"] = "Confirmar avance de efectivo"; }

<div class="card panel" style="max-width:480px; margin: 0 auto;">
    <div class="section-title">Confirmar operación</div>
    
    <div class="confirm-box">
        <div class="confirm-row">
            <span>Tarjeta origen (ID)</span>
            <b>#@Model.CreditCardId</b>
        </div>
        <div class="confirm-row">
            <span>Cuenta destino</span>
            <b>@Model.DestinationAccountNumber</b>
        </div>
        <div class="confirm-row">
            <span>Monto solicitado</span>
            <b>@Model.Amount.ToString("C2")</b>
        </div>
        <div class="confirm-row" style="color:var(--danger)">
            <span>Interés (6.25%)</span>
            <b>@((Model.Amount * 0.0625m).ToString("C2"))</b>
        </div>
        <div class="confirm-row" style="border-top:1px solid var(--border); padding-top:8px; margin-top:4px;">
            <span>Total cargado a tarjeta</span>
            <b>@((Model.Amount * 1.0625m).ToString("C2"))</b>
        </div>
    </div>
    
    <div style="font-size:13px;margin:16px 0;">¿Está seguro que desea realizar esta operación?</div>
    
    <form asp-action="ConfirmCashAdvance" method="post" style="margin:0;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="confirmed" value="true" />
        <div style="display:flex;gap:10px;">
            <a asp-action="CashAdvance" class="btn btn-ghost btn-block">Cancelar</a>
            <button type="submit" class="btn btn-primary btn-block">Confirmar</button>
        </div>
    </form>
</div>