@model ArtemisBankingPro.Core.Application.Features.Clients.Commands.CashAdvance.CashAdvanceCommand
@{
    ViewData["Title"] = "Confirmar Avance de Efectivo";
    var interest = Model.Amount * 0.0625m;
    var totalDebt = Model.Amount + interest;
}
<div class="topbar"><div class="crumb">Cliente</div><h1 id="screen-title">Confirmar avance de efectivo</h1></div>
<div class="card panel" style="max-width:480px;">
    <div class="section-title">Confirmar operación</div>
    <div class="confirm-box">
        <div class="confirm-row"><span>Tarjeta</span><b>#@Model.CreditCardId</b></div>
        <div class="confirm-row"><span>Cuenta destino</span><b>@Model.DestinationAccountNumber</b></div>
        <div class="confirm-row"><span>Monto a recibir</span><b>@Model.Amount.ToString("C2")</b></div>
        <div class="confirm-row"><span>Interés (6.25%)</span><b>@interest.ToString("C2")</b></div>
        <div class="confirm-row"><span>Deuda total a agregar</span><b>@totalDebt.ToString("C2")</b></div>
    </div>
    <div style="font-size:13px;margin:16px 0;">¿Está seguro que desea realizar esta operación?</div>
    <form asp-action="ConfirmCashAdvance" method="post" style="display:flex;gap:10px;">
        @Html.AntiForgeryToken()
        <button type="submit" name="confirmed" value="false" class="btn btn-ghost btn-block">Cancelar</button>
        <button type="submit" name="confirmed" value="true" class="btn btn-primary btn-block">Confirmar</button>
    </form>
</div>