@model ArtemisBankingPro.Core.Application.Features.Clients.Commands.TransferToBeneficiary.TransferToBeneficiaryCommand
@{
    ViewData["Title"] = "Transferencia a Beneficiario";
    var beneficiaries = ViewBag.Beneficiaries as List<ArtemisBankingPro.Core.Application.Features.Clients.Queries.GetBeneficiaries.BeneficiaryDto>;
}
<div class="topbar"><div class="crumb">Cliente</div><h1 id="screen-title">Transferencia a Beneficiario</h1></div>
<div class="two-col">
    <div class="card panel">
        <form asp-action="TransferToBeneficiary" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-info"></div>
            <div class="field"><label asp-for="SourceAccountNumber">Cuenta de Origen <span class="req">*</span></label><input asp-for="SourceAccountNumber" /><span asp-validation-for="SourceAccountNumber" class="text-danger"></span></div>
            <div class="field">
                <label asp-for="BeneficiaryId">Beneficiario <span class="req">*</span></label>
                <select asp-for="BeneficiaryId">
                    <option value="">-- Selecciona un beneficiario --</option>
                    @if (beneficiaries != null)
                    {
                        foreach (var b in beneficiaries)
                        {
                            <option value="@b.Id">@b.Alias (@b.BeneficiaryAccountNumber)</option>
                        }
                    }
                </select>
                <span asp-validation-for="BeneficiaryId" class="text-danger"></span>
            </div>
            <div class="field"><label asp-for="Amount">Monto <span class="req">*</span></label><input asp-for="Amount" type="number" step="0.01" /><span asp-validation-for="Amount" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary btn-block">Continuar</button>
        </form>
    </div>
    <div class="card panel">
        <div class="section-title">Reglas clave</div>
        <ul style="margin:0;padding-left:18px;font-size:12.3px;color:var(--text-dim);line-height:1.7;">
            <li>Solo puedes transferir a beneficiarios ya guardados.</li>
            <li>Si no tienes beneficiarios, agrégalos primero desde la sección Beneficiarios.</li>
        </ul>
    </div>
</div>