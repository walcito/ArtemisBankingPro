@model ArtemisBankingPro.Core.Application.Features.Clients.Commands.CashAdvance.CashAdvanceCommand
@{ ViewData["Title"] = "Avance de Efectivo"; }
<div class="topbar"><div class="crumb">Cliente</div><h1 id="screen-title">Avance de Efectivo</h1></div>
<div class="two-col">
    <div class="card panel">
        <form asp-action="CashAdvance" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-info"></div>
            <div class="field"><label asp-for="CreditCardId">ID de la Tarjeta <span class="req">*</span></label><input asp-for="CreditCardId" type="number" /><span asp-validation-for="CreditCardId" class="text-danger"></span></div>
            <div class="field"><label asp-for="DestinationAccountNumber">Cuenta Destino <span class="req">*</span></label><input asp-for="DestinationAccountNumber" /><span asp-validation-for="DestinationAccountNumber" class="text-danger"></span></div>
            <div class="field"><label asp-for="Amount">Monto a Retirar <span class="req">*</span></label><input asp-for="Amount" type="number" step="0.01" /><span asp-validation-for="Amount" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary btn-block">Continuar</button>
        </form>
    </div>
    <div class="card panel">
        <div class="section-title">Reglas clave</div>
        <ul style="margin:0;padding-left:18px;font-size:12.3px;color:var(--text-dim);line-height:1.7;">
            <li>Se aplica un interés del 6.25% sobre el monto solicitado.</li>
            <li>La tarjeta y la cuenta destino deben ser de tu propiedad.</li>
            <li>El monto + interés no puede superar el crédito disponible.</li>
        </ul>
    </div>
</div>