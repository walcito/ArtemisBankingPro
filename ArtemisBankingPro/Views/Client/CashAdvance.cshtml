@model ArtemisBankingPro.Core.Application.Features.Clients.Commands.CashAdvance.CashAdvanceCommand
@{ ViewData["Title"] = "Avance de efectivo"; }

<div class="two-col">
    <div class="card panel">
        <form asp-action="CashAdvance" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-info" style="@(!ViewData.ModelState.IsValid ? "" : "display:none;")"></div>
            
            <div class="field">
                <label asp-for="CreditCardId">Tarjeta de crédito origen <span class="req">*</span></label>
                <select asp-for="CreditCardId">
                    <option value="">-- Seleccionar --</option>
                    @if(ViewBag.Cards != null)
                    {
                        foreach(var card in ViewBag.Cards)
                        {
                            <option value="@card.Id">@card.Identifier</option>
                        }
                    }
                </select>
                <span asp-validation-for="CreditCardId" class="text-danger" style="font-size:11px;"></span>
            </div>
            
            <div class="field">
                <label asp-for="DestinationAccountNumber">Cuenta de ahorro destino <span class="req">*</span></label>
                <select asp-for="DestinationAccountNumber">
                    <option value="">-- Seleccionar --</option>
                    @if(ViewBag.Accounts != null)
                    {
                        foreach(var acc in ViewBag.Accounts)
                        {
                            <option value="@acc.Identifier">@acc.Identifier</option>
                        }
                    }
                </select>
                <span asp-validation-for="DestinationAccountNumber" class="text-danger" style="font-size:11px;"></span>
            </div>
            
            <div class="field">
                <label asp-for="Amount">Monto del avance <span class="req">*</span></label>
                <input asp-for="Amount" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="Amount" class="text-danger" style="font-size:11px;"></span>
            </div>
            
            <div class="alert alert-info" style="margin-top:6px;">Se aplica un interés del <b>6.25%</b> sobre el monto solicitado, cargado a la tarjeta.</div>
            
            <button type="submit" class="btn btn-primary btn-block" style="margin-top:14px;">Realizar avance</button>
        </form>
    </div>
    
    <div class="card panel">
        <div class="section-title">Reglas clave</div>
        <ul style="margin:0;padding-left:18px;font-size:12.3px;color:var(--text-dim);line-height:1.7;">
            <li>El total a cargar (monto + interés) no puede superar el crédito disponible.</li>
            <li>El monto depositado en la cuenta es únicamente el monto solicitado.</li>
            <li>Se registra como consumo tipo AVANCE en la tarjeta.</li>
        </ul>
    </div>
</div>