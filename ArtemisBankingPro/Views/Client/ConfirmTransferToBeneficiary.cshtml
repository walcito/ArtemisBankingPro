@model ArtemisBankingPro.Core.Application.Features.Clients.Commands.TransferToBeneficiary.TransferToBeneficiaryCommand
@{ ViewData["Title"] = "Confirmar Transferencia"; }
<div class="topbar"><div class="crumb">Cliente</div><h1 id="screen-title">Confirmar transferencia a beneficiario</h1></div>
<div class="card panel" style="max-width:480px;">
    <div class="section-title">Confirmar operación</div>
    <div class="confirm-box">
        <div class="confirm-row"><span>Cuenta origen</span><b>@Model.SourceAccountNumber</b></div>
        <div class="confirm-row"><span>Beneficiario ID</span><b>#@Model.BeneficiaryId</b></div>
        <div class="confirm-row"><span>Monto</span><b>@Model.Amount.ToString("C2")</b></div>
    </div>
    <div style="font-size:13px;margin:16px 0;">¿Está seguro que desea realizar esta operación?</div>
    <form asp-action="ConfirmTransferToBeneficiary" method="post" style="display:flex;gap:10px;">
        @Html.AntiForgeryToken()
        <button type="submit" name="confirmed" value="false" class="btn btn-ghost btn-block">Cancelar</button>
        <button type="submit" name="confirmed" value="true" class="btn btn-primary btn-block">Confirmar</button>
    </form>
</div>