@model ArtemisBankingPro.Core.Application.ViewModels.Client.TransferOwnAccountsViewModel
@{ ViewData["Title"] = "Transferencia entre cuentas"; }

<div class="two-col">
    <div class="card panel">
        <form asp-action="TransferOwnAccounts" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-info" style="@(!ViewData.ModelState.IsValid ? "" : "display:none;")"></div>
            
            <div class="field">
                <label asp-for="SourceAccountNumber">Cuenta de origen <span class="req">*</span></label>
                <select asp-for="SourceAccountNumber">
                    <option value="">-- Seleccionar --</option>
                    @if(ViewBag.Accounts != null)
                    {
                        foreach(var acc in ViewBag.Accounts)
                        {
                            <option value="@acc.Identifier">@acc.Identifier (@acc.Status) — @acc.RelevantAmount.ToString("C2")</option>
                        }
                    }
                </select>
                <span asp-validation-for="SourceAccountNumber" class="text-danger" style="font-size:11px;"></span>
            </div>
            
            <div class="field">
                <label asp-for="DestinationAccountNumber">Cuenta de destino <span class="req">*</span></label>
                <select asp-for="DestinationAccountNumber">
                    <option value="">-- Seleccionar --</option>
                    @if(ViewBag.Accounts != null)
                    {
                        foreach(var acc in ViewBag.Accounts)
                        {
                            <option value="@acc.Identifier">@acc.Identifier (@acc.Status)</option>
                        }
                    }
                </select>
                <span asp-validation-for="DestinationAccountNumber" class="text-danger" style="font-size:11px;"></span>
            </div>
            
            <div class="field">
                <label asp-for="Amount">Monto a transferir <span class="req">*</span></label>
                <input asp-for="Amount" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="Amount" class="text-danger" style="font-size:11px;"></span>
            </div>
            
            <button type="submit" class="btn btn-primary btn-block">Realizar transferencia</button>
        </form>
    </div>
    
    <div class="card panel">
        <div class="section-title">Reglas clave</div>
        <ul style="margin:0;padding-left:18px;font-size:12.3px;color:var(--text-dim);line-height:1.7;">
            <li>Origen y destino deben ser cuentas propias y activas.</li>
            <li>No pueden ser la misma cuenta.</li>
            <li>Requiere al menos dos cuentas activas.</li>
        </ul>
    </div>
</div>