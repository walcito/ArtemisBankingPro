@model ArtemisBankingPro.Core.Application.Features.Clients.Commands.TransferBetweenOwnAccounts.TransferBetweenOwnAccountsCommand
@{ ViewData["Title"] = "Transferencia entre Cuentas"; }
<div class="topbar"><div class="crumb">Cliente</div><h1 id="screen-title">Transferencia entre cuentas propias</h1></div>
<div class="two-col">
    <div class="card panel">
        <form asp-action="TransferOwnAccounts" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-info"></div>
            <div class="field"><label asp-for="SourceAccountNumber">Cuenta de Origen <span class="req">*</span></label><input asp-for="SourceAccountNumber" /><span asp-validation-for="SourceAccountNumber" class="text-danger"></span></div>
            <div class="field"><label asp-for="DestinationAccountNumber">Cuenta de Destino <span class="req">*</span></label><input asp-for="DestinationAccountNumber" /><span asp-validation-for="DestinationAccountNumber" class="text-danger"></span></div>
            <div class="field"><label asp-for="Amount">Monto <span class="req">*</span></label><input asp-for="Amount" type="number" step="0.01" /><span asp-validation-for="Amount" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary btn-block">Continuar</button>
        </form>
    </div>
    <div class="card panel">
        <div class="section-title">Reglas clave</div>
        <ul style="margin:0;padding-left:18px;font-size:12.3px;color:var(--text-dim);line-height:1.7;">
            <li>Ambas cuentas deben ser de tu propiedad.</li>
            <li>Origen y destino no pueden ser la misma cuenta.</li>
        </ul>
    </div>
</div>