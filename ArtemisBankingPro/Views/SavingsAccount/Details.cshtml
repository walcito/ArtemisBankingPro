@model ArtemisBankingPro.Core.Application.Common.Models.PagedResult<ArtemisBankingPro.Core.Application.Features.SavingsAccounts.Queries.GetAccountTransactions.TransactionDto>

@{
    ViewData["Title"] = "Historial de Transacciones";
    var accountNumber = ViewBag.AccountNumber as string;
}

<h2>Historial — Cuenta @accountNumber</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Monto</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var transaction in Model.Items)
        {
            <tr>
                <td>@transaction.Date.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <span class="badge @(transaction.Type.ToString() == "Credit" ? "bg-success" : "bg-danger")">
                        @transaction.Type
                    </span>
                </td>
                <td>@transaction.Amount.ToString("C2")</td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" asp-action="Details"
                    asp-route-accountNumber="@accountNumber" asp-route-pageNumber="@i">@i</a>
            </li>
        }
    </ul>
</nav>

<a asp-action="Index" class="btn btn-secondary">Volver</a>