@model ArtemisBankingPro.Core.Application.Common.Models.PagedResult<ArtemisBankingPro.Core.Application.Features.SavingsAccounts.Queries.GetAccountTransactions.TransactionDto>
@{
    ViewData["Title"] = $"Cuenta {ViewBag.AccountNumber} · Movimientos";
}

<div class="card panel" style="margin-bottom:18px;">
    <div class="amount-hero">@(((decimal)ViewBag.Balance).ToString("C2")) <small>balance disponible</small></div>
</div>

<div class="card panel">
    <div class="section-title">Transacciones (más recientes primero)</div>
    @foreach (var tx in Model.Items)
    {
        var isCredit = tx.Type.ToString() == "Credit" || tx.Type.ToString() == "Deposit";
        <div class="tx-row">
            <div class="tx-left">
                <div class="tx-ic @(isCredit ? "credit" : "debit")">@(isCredit ? "↓" : "↑")</div>
                <div>
                    <div class="tx-title">@tx.Description</div>
                    <div class="tx-sub">@tx.Date.ToString("dd/MM/yyyy HH:mm") · <span class="badge ok" style="padding:2px 8px;">APROBADA</span></div>
                </div>
            </div>
            <div class="tx-amt @(isCredit ? "credit" : "debit")">@(isCredit ? "+" : "−") @tx.Amount.ToString("C2")</div>
        </div>
    }
    @if (!Model.Items.Any())
    {
        <div class="skeleton-empty">
            <div class="ic">📄</div>
            <h4>Sin movimientos</h4>
            <p>Esta cuenta no tiene transacciones registradas aún.</p>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="switch-tabs" style="margin-top: 20px;">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a href="?pageNumber=@i" class="btn btn-ghost @(i == Model.PageNumber ? "on" : "")" style="border: none; padding: 8px 16px;">@i</a>
        }
    </div>
}

<a asp-action="Index" class="btn btn-ghost" style="margin-top:16px;">← Volver atrás</a>