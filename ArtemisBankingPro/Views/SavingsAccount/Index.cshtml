@model ArtemisBankingPro.Core.Application.Common.Models.PagedResult<ArtemisBankingPro.Core.Application.Features.SavingsAccounts.Queries.GetSavingsAccounts.SavingsAccountDto>

@{
    ViewData["Title"] = "Gestión de Cuentas de Ahorro";
}

<form method="get" class="toolbar">
    <div class="field" style="max-width:180px;">
        <label>Filtrar por estado</label>
        <select name="status" onchange="this.form.submit()">
            <option value="">Todos</option>
            <option value="Active" selected="@(Context.Request.Query["status"] == "Active")">Activa</option>
            <option value="Cancelled" selected="@(Context.Request.Query["status"] == "Cancelled")">Cancelada</option>
        </select>
    </div>
    <div class="field" style="max-width:180px;">
        <label>Filtrar por tipo</label>
        <select name="type" onchange="this.form.submit()">
            <option value="">Todos</option>
            <option value="Primary" selected="@(Context.Request.Query["type"] == "Primary")">Principal</option>
            <option value="Secondary" selected="@(Context.Request.Query["type"] == "Secondary")">Secundaria</option>
        </select>
    </div>
    <div class="field" style="max-width:220px;">
        <label>Buscar por cédula</label>
        <input name="identificationNumber" placeholder="402-0000000-0" value="@Context.Request.Query["identificationNumber"]" onblur="this.form.submit()">
    </div>
    <a asp-action="Create" class="btn btn-primary" style="margin-left:auto;">+ Asignar cuenta secundaria</a>
</form>

<div class="card">
    <table>
        <tr>
            <th>N° de cuenta</th>
            <th>Cliente</th>
            <th>Tipo</th>
            <th>Balance</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
        @foreach (var account in Model.Items)
        {
            <tr>
                <td style="font-weight:700">@account.AccountNumber</td>
                <td>@account.UserFullName</td>
                <td><span class="badge info">@(account.Type.ToString() == "Primary" ? "Principal" : "Secundaria")</span></td>
                <td>@account.Balance.ToString("C2")</td>
                <td>
                    <span class="badge @(account.Status.ToString() == "Active" ? "ok" : "bad")">
                        @(account.Status.ToString() == "Active" ? "Activa" : "Cancelada")
                    </span>
                </td>
                <td class="row-actions">
                    <a asp-action="Details" asp-route-accountNumber="@account.AccountNumber" class="btn btn-ghost btn-sm">Ver movimientos</a>
                    @if (account.Type.ToString() == "Secondary" && account.Status.ToString() == "Active")
                    {
                        <form asp-action="Cancel" method="post" class="d-inline" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="accountNumber" value="@account.AccountNumber" />
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro que desea cancelar esta cuenta?');">
                                Cancelar
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="6" class="skeleton-empty">
                    <div class="ic">🏦</div>
                    <h4>No hay cuentas de ahorro</h4>
                    <p>No se encontraron resultados para los filtros aplicados.</p>
                </td>
            </tr>
        }
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="switch-tabs" style="margin-top: 20px;">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a href="?pageNumber=@i&status=@Context.Request.Query["status"]&type=@Context.Request.Query["type"]&identificationNumber=@Context.Request.Query["identificationNumber"]" class="btn btn-ghost @(i == Model.PageNumber ? "on" : "")" style="border: none; padding: 8px 16px;">@i</a>
        }
    </div>
}